<UserControl x:Class="SteamTracker.UI.Views.AchievementPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Досягнення" Style="{StaticResource Title}" />
        <TextBlock Text="Плануй, які досягнення закрити далі" Style="{StaticResource Muted}" Margin="0,4,0,24" />

        <Border Style="{StaticResource Card}">
            <TextBlock Text="Екран у розробці" Style="{StaticResource Muted}" />
        </Border>
    </StackPanel>
</UserControl>
