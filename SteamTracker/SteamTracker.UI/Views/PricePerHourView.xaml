<UserControl x:Class="SteamTracker.UI.Views.PricePerHourView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Бібліотека" Style="{StaticResource Title}" />
        <TextBlock Text="Вартість години гри та ігри, які ще чекають на запуск" Style="{StaticResource Muted}" Margin="0,4,0,24" />

        <Border Style="{StaticResource Card}">
            <TextBlock Text="Екран у розробці" Style="{StaticResource Muted}" />
        </Border>
    </StackPanel>
</UserControl>
