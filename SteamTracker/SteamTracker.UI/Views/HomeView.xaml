<UserControl x:Class="SteamTracker.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Головна" Style="{StaticResource Title}" />
        <TextBlock Text="Короткий огляд твого Steam-акаунту" Style="{StaticResource Muted}" Margin="0,4,0,24" />

        <Border Style="{StaticResource Card}">
            <TextBlock Text="Екран у розробці" Style="{StaticResource Muted}" />
        </Border>
    </StackPanel>
</UserControl>
