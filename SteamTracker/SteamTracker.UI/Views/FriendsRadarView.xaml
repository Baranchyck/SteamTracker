<UserControl x:Class="SteamTracker.UI.Views.FriendsRadarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Друзі-радар" Style="{StaticResource Title}" />
        <TextBlock Text="Хто з друзів зараз онлайн і у що грає" Style="{StaticResource Muted}" Margin="0,4,0,24" />

        <Border Style="{StaticResource Card}">
            <TextBlock Text="Екран у розробці" Style="{StaticResource Muted}" />
        </Border>
    </StackPanel>
</UserControl>
