<!-- Екран «Друзі-радар» за макетом Figma «05 · Друзі-радар» + вимоги issue #75 -->
<UserControl x:Class="SteamTracker.UI.Views.FriendsRadarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SteamTracker.UI.Controls"
             xmlns:converters="clr-namespace:SteamTracker.UI.Converters"
             xmlns:radar="clr-namespace:SteamTracker.UI.Views.FriendsRadar">

    <UserControl.Resources>
        <converters:IconUrlConverter x:Key="AvatarUrl" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок, фільтр «Усі / Вільні зараз», «Оновити» і легенда статусів -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel x:Name="ToolsPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Style="{StaticResource SegmentGroup}">
                        <StackPanel Orientation="Horizontal" RadioButton.Checked="Filter_Checked">
                            <RadioButton x:Name="AllFilter" Style="{StaticResource SegmentItem}" GroupName="RadarFilter" IsChecked="True">
                                <TextBlock x:Name="AllFilterText" Text="Усі" />
                            </RadioButton>
                            <RadioButton x:Name="AvailableFilter" Style="{StaticResource SegmentItem}" GroupName="RadarFilter">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="AvailableFilterText" Text="Вільні зараз" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <Button x:Name="RefreshButton" Content="Оновити" Style="{StaticResource SecondaryButton}" FontSize="12"
                            Margin="10,0,0,0" Click="Refresh_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Друзі-радар" Style="{StaticResource Title}" />
                    <TextBlock Text="Хто зараз у Steam і в що грає" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Лічильники за статусами: «У грі · 3 · Онлайн · 3 · ...» -->
            <StackPanel x:Name="LegendPanel" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
                <Ellipse Width="6" Height="6" Fill="{StaticResource Success}" VerticalAlignment="Center" />
                <TextBlock x:Name="InGameCountText" Style="{StaticResource Muted}" FontSize="12" Margin="6,0,16,0" />
                <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                <TextBlock x:Name="OnlineCountText" Style="{StaticResource Muted}" FontSize="12" Margin="6,0,16,0" />
                <Ellipse Width="6" Height="6" Fill="{StaticResource Warning}" VerticalAlignment="Center" />
                <TextBlock x:Name="AwayCountText" Style="{StaticResource Muted}" FontSize="12" Margin="6,0,16,0" />
                <Ellipse Width="6" Height="6" Fill="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                <TextBlock x:Name="OfflineCountText" Style="{StaticResource Muted}" FontSize="12" Margin="6,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Сітка карток друзів; ховається, коли показується картка стану -->
        <Grid Grid.Row="1" x:Name="ContentPanel" Visibility="Collapsed">
            <TextBlock x:Name="NoAvailableText" Style="{StaticResource Muted}" VerticalAlignment="Top" Visibility="Collapsed"
                       Text="Зараз ніхто з друзів не вільний для гри. Спробуй оновити трохи пізніше." />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                </ScrollViewer.Resources>

                <ItemsControl x:Name="FriendsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type radar:FriendRow}">
                            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,12,12" Opacity="{Binding Opacity}">
                                <DockPanel>
                                    <!-- Аватар: коло з першою літерою, поверх — картинка, якщо завантажилась; точка — статус -->
                                    <Grid DockPanel.Dock="Left" Width="36" Height="36" VerticalAlignment="Center">
                                        <Ellipse Fill="{Binding AvatarBrush}" />
                                        <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextOnAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource AvatarUrl}}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="11" Height="11" Fill="{Binding StatusBrush}" Stroke="{StaticResource Surface}" StrokeThickness="2"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>

                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusBrush}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding GameName}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0" Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <controls:StateView x:Name="StatePanel" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <!-- Лише в Debug з фейковим сервісом: перемикач, щоб побачити кожен стан екрана -->
        <StackPanel x:Name="FakeModePanel" Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock Text="Фейковий сервіс (Debug):" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Border Style="{StaticResource SegmentGroup}">
                <StackPanel Orientation="Horizontal" RadioButton.Checked="FakeMode_Checked">
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="FakeMode" Content="Дані" Tag="Data" IsChecked="True" />
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="FakeMode" Content="Порожньо" Tag="Empty" />
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="FakeMode" Content="Помилка" Tag="Error" />
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="FakeMode" Content="Приватний" Tag="Private" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
