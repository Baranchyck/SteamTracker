<!-- Екран «Co-op Matchmaker» за макетом Figma «06 · Co-op Matchmaker» + вимоги issue #88 -->
<UserControl x:Class="SteamTracker.UI.Views.MatchmakerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SteamTracker.UI.Controls"
             xmlns:converters="clr-namespace:SteamTracker.UI.Converters"
             xmlns:mm="clr-namespace:SteamTracker.UI.Views.Matchmaker">

    <UserControl.Resources>
        <converters:IconUrlConverter x:Key="IconUrl" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Обкладинка гри: сіра заглушка, поверх неї — іконка, коли завантажиться -->
        <DataTemplate x:Key="Cover">
            <Border Width="48" Height="24" CornerRadius="4" Background="{StaticResource SurfaceRaised}">
                <Border CornerRadius="4">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Converter={StaticResource IconUrl}}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Border>
        </DataTemplate>

        <!-- Поле вводу SteamID / посилання / ніка: той самий вигляд, що в NumberBox, але на всю ширину -->
        <Style x:Key="AddBox" TargetType="TextBox" BasedOn="{StaticResource NumberBox}">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Co-op Matchmaker" Style="{StaticResource Title}" />
            <TextBlock Text="Знайди гру, яка є в усій компанії" Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="9*" />
            </Grid.ColumnDefinitions>

            <!-- Ліворуч: хто в складі -->
            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Учасники" Style="{StaticResource Heading}" />
                        <TextBlock x:Name="LimitText" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Обери друзів зі списку або додай гравця за SteamID" />
                    </StackPanel>

                    <ScrollViewer x:Name="ParticipantsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                        </ScrollViewer.Resources>

                        <StackPanel>
                            <ItemsControl x:Name="ParticipantsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type mm:ParticipantRow}">
                                        <DockPanel Margin="0,0,0,10" Background="Transparent" Opacity="{Binding Opacity}">
                                            <!-- «завжди» для себе, жовтий «Бібліотека прихована» після пошуку -->
                                            <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LibraryHidden}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource WarningSoft}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding BadgeText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                            <Setter Property="FontSize" Value="11" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LibraryHidden}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <CheckBox Style="{StaticResource FilterCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsHitTestVisible="{Binding CanToggle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Аватар: коло з першою літерою, поверх — картинка, якщо завантажилась -->
                                                    <Grid Width="26" Height="26">
                                                        <Ellipse Fill="{Binding AvatarBrush}" />
                                                        <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextOnAccent}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Ellipse>
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource IconUrl}}" Stretch="UniformToFill" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Друзів не вдалося завантажити (приховані, помилка) — гравців можна додати вручну -->
                            <TextBlock x:Name="FriendsHintText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="Collapsed" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Додати гравця, якого немає серед друзів -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,12">
                        <DockPanel>
                            <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Додати" Style="{StaticResource SecondaryButton}"
                                    FontSize="12" Margin="8,0,0,0" Click="Add_Click" />
                            <TextBox x:Name="AddBox" Style="{StaticResource AddBox}" ToolTip="SteamID64, посилання на профіль або нік"
                                     KeyDown="AddBox_KeyDown" TextChanged="AddBox_TextChanged" />
                        </DockPanel>
                        <TextBlock x:Name="AddMessageText" Style="{StaticResource Muted}" FontSize="12" Foreground="{StaticResource Danger}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <Button x:Name="FindButton" Grid.Row="3" Style="{StaticResource PrimaryButton}" Click="Find_Click" />
                </Grid>
            </Border>

            <!-- Праворуч: результат або картка стану -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- Жовтий: частина бібліотек прихована, результат неповний -->
                    <Border x:Name="HiddenBanner" Visibility="Collapsed" Background="{StaticResource WarningSoft}" CornerRadius="8"
                            Padding="14,10" Margin="0,0,0,12">
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{StaticResource Warning}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="HiddenBannerText" FontSize="13" Foreground="{StaticResource Warning}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <!-- Червоний: частину вводів не вдалося розпізнати -->
                    <Border x:Name="InvalidBanner" Visibility="Collapsed" Background="{StaticResource DangerSoft}" CornerRadius="8"
                            Padding="14,10" Margin="0,0,0,12">
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{StaticResource Danger}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="InvalidBannerText" FontSize="13" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <Border x:Name="ResultCard" Grid.Row="1" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="Сер. час гри" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Bottom" />
                            <StackPanel>
                                <TextBlock x:Name="ResultTitleText" Style="{StaticResource Heading}" />
                                <TextBlock Text="Відсортовано за середнім часом гри групи" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                            </ScrollViewer.Resources>

                            <ItemsControl x:Name="GamesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type mm:CommonGameRow}">
                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,10"
                                                ToolTip="{Binding Tooltip}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="76" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Rank}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                                <ContentPresenter Grid.Column="1" Content="{Binding IconUrl}" ContentTemplate="{StaticResource Cover}"
                                                                  VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Смуга відносно найпопулярнішої гри списку -->
                                                <Border Grid.Column="3" Height="4" CornerRadius="2" Background="{StaticResource SurfaceRaised}"
                                                        VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding FillWidth}" />
                                                            <ColumnDefinition Width="{Binding RestWidth}" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border CornerRadius="2" Background="{StaticResource Accent}" />
                                                    </Grid>
                                                </Border>

                                                <TextBlock Grid.Column="4" Text="{Binding Hours}" FontSize="14" FontWeight="Medium"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Ще не шукали -->
                <TextBlock x:Name="HintText" Grid.Row="1" Style="{StaticResource Muted}" VerticalAlignment="Top" TextWrapping="Wrap"
                           Text="Познач учасників зліва й натисни «Знайти спільні ігри» — тут з’являться ігри, які є в усіх." />

                <controls:StateView x:Name="StatePanel" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- Лише в Debug з фейковим сервісом: перемикач, щоб побачити кожен стан екрана -->
        <StackPanel x:Name="FakeModePanel" Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock Text="Фейковий сервіс (Debug):" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Border Style="{StaticResource SegmentGroup}">
                <StackPanel Orientation="Horizontal" RadioButton.Checked="FakeMode_Checked">
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="FakeMode" Content="Дані" Tag="Data" IsChecked="True" />
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="FakeMode" Content="Немає спільних" Tag="Empty" />
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="FakeMode" Content="Помилка" Tag="Error" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
