<!-- Екран «Час гри з друзями» за макетом Figma «04 · Час гри з друзями» + вимоги issue #83 -->
<UserControl x:Class="SteamTracker.UI.Views.ComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SteamTracker.UI.Controls"
             xmlns:converters="clr-namespace:SteamTracker.UI.Converters"
             xmlns:models="clr-namespace:SteamTracker.Domain.Models;assembly=SteamTracker.Domain"
             xmlns:comparison="clr-namespace:SteamTracker.UI.Views.Comparison">

    <UserControl.Resources>
        <converters:IconUrlConverter x:Key="ImageUrl" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Фон бейджа «+14 год за 2 тижні» з макета -->
        <SolidColorBrush x:Key="SuccessSoft" Color="#22351F" />

        <!-- Аватар: коло з першою літерою, поверх — картинка, якщо завантажилась -->
        <DataTemplate x:Key="Avatar">
            <Grid Width="28" Height="28">
                <Ellipse Fill="{Binding AvatarBrush}" />
                <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextOnAccent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse>
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource ImageUrl}}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </DataTemplate>

        <!-- Вибір гри: рамка з обкладинкою, назвою і стрілкою, як «Game select» у макеті -->
        <Style x:Key="GameSelect" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SortComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                                                BorderThickness="1" CornerRadius="8" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <DockPanel Margin="14,0" IsHitTestVisible="False">
                                <Path DockPanel.Dock="Right" Data="M4.33013 0L8.66025 5.25H0L4.33013 0Z" Fill="{StaticResource TextSecondary}"
                                      VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="180" />
                                    </Path.RenderTransform>
                                </Path>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"
                                   Placement="Bottom" PopupAnimation="Fade" MinWidth="{TemplateBinding ActualWidth}">
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,6,0,0">
                                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                                        </ScrollViewer.Resources>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Рядок рейтингу: без системного виділення; рядок користувача підсвічений (RowBackground) -->
        <Style x:Key="RankRowContainer" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{Binding RowBackground}" CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовок картки, що згортає список: «Немає цієї гри  5  ▾» -->
        <Style x:Key="CollapseHeader" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsChecked" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <DockPanel Background="Transparent">
                            <Path x:Name="Chevron" DockPanel.Dock="Right" Data="M4.33013 0L8.66025 5.25H0L4.33013 0Z"
                                  Fill="{StaticResource TextSecondary}" VerticalAlignment="Center">
                                <Path.LayoutTransform>
                                    <RotateTransform Angle="180" />
                                </Path.LayoutTransform>
                            </Path>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <!-- Згорнуто — стрілка дивиться вправо -->
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Chevron" Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chevron" Property="Fill" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Список друзів у бічних картках: аватар + нік -->
        <DataTemplate x:Key="FriendItemTemplate" DataType="{x:Type comparison:FriendItem}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar}" />
                <TextBlock Text="{Binding Name}" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок і вибір гри -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <ComboBox x:Name="GameBox" DockPanel.Dock="Right" Style="{StaticResource GameSelect}" Width="300" Height="40"
                      VerticalAlignment="Center" Visibility="Collapsed" SelectionChanged="GameBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:OwnedGame}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="22" Height="22">
                                <Border Background="{StaticResource SurfaceRaised}" CornerRadius="4" />
                                <Border CornerRadius="4">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource ImageUrl}}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="220"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel>
                <TextBlock Text="Час гри з друзями" Style="{StaticResource Title}" />
                <TextBlock Text="Порівняння часу в обраній грі серед друзів" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Вміст; ховається, коли показується картка стану -->
        <Grid Grid.Row="1" x:Name="ContentPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Три картки статистики -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SectionCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Твоя позиція" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="PositionText" Style="{StaticResource StatValue}" />
                        <TextBlock x:Name="PositionCaption" Style="{StaticResource StatCaption}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SectionCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Твій час" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="MyTimeText" Style="{StaticResource StatValue}" Foreground="{StaticResource Accent}" />
                        <TextBlock x:Name="MyTimeCaption" Style="{StaticResource StatCaption}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource SectionCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Грали останні 2 тижні" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="TwoWeeksText" Style="{StaticResource StatValue}" Foreground="{StaticResource Success}" />
                        <TextBlock x:Name="TwoWeeksCaption" Style="{StaticResource StatCaption}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Рейтинг за весь час -->
                <Border Grid.Column="0" Style="{StaticResource SectionCard}" VerticalAlignment="Top">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Text="Годин у грі" Style="{StaticResource Muted}" FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Рейтинг за весь час" Style="{StaticResource Heading}" />
                        </DockPanel>

                        <ListBox x:Name="RankingList" Style="{StaticResource GameList}" ItemContainerStyle="{StaticResource RankRowContainer}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type comparison:RankRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding RankText}" Foreground="{Binding RankBrush}"
                                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />

                                        <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource Avatar}" />

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource SuccessSoft}" Margin="8,0,0,0"
                                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="12" Foreground="{StaticResource Success}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Смужка: частка від найбільшого часу в рейтингу -->
                                        <Border Grid.Column="6" Height="6" CornerRadius="3" Background="{StaticResource SurfaceRaised}"
                                                VerticalAlignment="Center">
                                            <Border Width="{Binding BarWidth}" CornerRadius="3" Background="{Binding BarBrush}"
                                                    HorizontalAlignment="Left" />
                                        </Border>

                                        <TextBlock Grid.Column="8" Text="{Binding HoursText}" FontSize="14" FontWeight="SemiBold"
                                                   TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Бічні згортані списки: «Немає цієї гри» і «Бібліотека прихована» -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <Border x:Name="WithoutGameCard" Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <ToggleButton x:Name="WithoutGameToggle" Style="{StaticResource CollapseHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Немає цієї гри" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                            <TextBlock x:Name="WithoutGameCount" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=WithoutGameToggle, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Друзі, яких можна запросити пограти" Style="{StaticResource Muted}" FontSize="13"
                                               Margin="0,12,0,14" />
                                    <ItemsControl x:Name="WithoutGameList" ItemTemplate="{StaticResource FriendItemTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PrivateCard" Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <ToggleButton x:Name="PrivateToggle" Style="{StaticResource CollapseHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Бібліотека прихована" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                            <TextBlock x:Name="PrivateCount" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=PrivateToggle, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,12,0,14"
                                               Text="Steam не показує їхні ігри, тому їх немає в рейтингу" />
                                    <ItemsControl x:Name="PrivateList" ItemTemplate="{StaticResource FriendItemTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <controls:StateView x:Name="StatePanel" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <!-- Лише в Debug з фейковим сервісом: перемикач, щоб побачити кожен стан екрана -->
        <StackPanel x:Name="FakeModePanel" Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock Text="Фейковий сервіс (Debug):" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Border Style="{StaticResource SegmentGroup}">
                <StackPanel Orientation="Horizontal" RadioButton.Checked="FakeMode_Checked">
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="FakeMode" Content="Дані" Tag="Data" IsChecked="True" />
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="FakeMode" Content="Порожньо" Tag="Empty" />
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="FakeMode" Content="Помилка" Tag="Error" />
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="FakeMode" Content="Приватний" Tag="Private" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
