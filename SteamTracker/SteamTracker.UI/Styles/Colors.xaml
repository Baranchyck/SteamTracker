<!-- Кольори з макета Figma «Steam Tracker — MVP UI» -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Background" Color="#0D141C" />
    <SolidColorBrush x:Key="Sidebar" Color="#131A24" />
    <SolidColorBrush x:Key="Surface" Color="#17232F" />
    <SolidColorBrush x:Key="Border" Color="#243241" />

    <SolidColorBrush x:Key="Accent" Color="#4C9FE6" />
    <SolidColorBrush x:Key="Success" Color="#87BA6F" />
    <SolidColorBrush x:Key="Danger" Color="#E5534B" />

    <SolidColorBrush x:Key="NavHover" Color="#18222E" />
    <SolidColorBrush x:Key="NavActive" Color="#1B3653" />

    <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3" />
    <SolidColorBrush x:Key="TextSecondary" Color="#8B98A8" />
    <!-- Текст на кнопках кольору Accent -->
    <SolidColorBrush x:Key="TextOnAccent" Color="#0B1219" />

    <!-- Заглушки обкладинок, фон смужок, скелетони, нейтральні кнопки й бейджі -->
    <SolidColorBrush x:Key="SurfaceRaised" Color="#223041" />

    <SolidColorBrush x:Key="DangerSoft" Color="#3C1D1D" />
    <SolidColorBrush x:Key="Warning" Color="#E6B84A" />
    <SolidColorBrush x:Key="WarningSoft" Color="#3A3017" />

</ResourceDictionary>
