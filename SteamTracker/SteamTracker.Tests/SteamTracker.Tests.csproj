<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- windows: тести UI (форматування, IconUrlConverter, фейки) посилаються на WPF-проєкт -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit тягне NETStandard.Library 1.6.1, а той — вразливі версії 4.3.0 цих пакетів.
         Прямі посилання піднімають їх до виправлених -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteamTracker.DataAccess\SteamTracker.DataAccess.csproj" />
    <ProjectReference Include="..\SteamTracker.Domain\SteamTracker.Domain.csproj" />
    <ProjectReference Include="..\SteamTracker.Integrations\SteamTracker.Integrations.csproj" />
    <ProjectReference Include="..\SteamTracker.Services\SteamTracker.Services.csproj" />
    <ProjectReference Include="..\SteamTracker.UI\SteamTracker.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
